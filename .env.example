# Copy to .env to change any of these. docker compose and the API both read .env, and every value here is
# already the default, so local development works without one.

# Postgres container
POSTGRES_USER=unnoodle
POSTGRES_PASSWORD=unnoodle
POSTGRES_DB=unnoodle
POSTGRES_PORT=5432

# API
UNNOODLE_DATABASE_URL=postgresql+psycopg://unnoodle:unnoodle@127.0.0.1:5432/unnoodle

# API tests that need Postgres run only when this is set. They create this database if it is missing, migrate it
# and empty its tables after each test, so keep it separate from the one above.
UNNOODLE_TEST_DATABASE_URL=postgresql+psycopg://unnoodle:unnoodle@127.0.0.1:5432/unnoodle_test

# The ComfyUI the worker runs workflows on: the dev one on 8189 (see the README), or a regular install on 8188
UNNOODLE_COMFYUI_URL=http://127.0.0.1:8189

# Uncomment to also run the API tests that talk to a real ComfyUI (the dev one, running)
# UNNOODLE_TEST_COMFYUI_URL=http://127.0.0.1:8189
