# Copy to .env to change any of these. docker compose and the API both read .env, and every value here is
# already the default, so local development works without one.

# Postgres container
POSTGRES_USER=unnoodle
POSTGRES_PASSWORD=unnoodle
POSTGRES_DB=unnoodle
POSTGRES_PORT=5432

# API
UNNOODLE_DATABASE_URL=postgresql+psycopg://unnoodle:unnoodle@127.0.0.1:5432/unnoodle

# Sends the sign-in cookie over HTTPS only. Turn on wherever the app is served over HTTPS, such as the tailnet address.
UNNOODLE_SECURE_COOKIES=false

# API tests that need Postgres run only when this is set. They create this database if it is missing, migrate it
# and empty its tables after each test, so keep it separate from the one above.
UNNOODLE_TEST_DATABASE_URL=postgresql+psycopg://unnoodle:unnoodle@127.0.0.1:5432/unnoodle_test

# The the renderer the worker runs pipelines on: the dev one on 8189 (see the README), or one with the models, such as a
# rented GPU tunnelled to this machine
UNNOODLE_RENDERER_URL=http://127.0.0.1:8189

# The pipelines on offer: "dev" stand-ins that run on the dev renderer, or "real" ones that need the models
UNNOODLE_PIPELINES=dev

# Uncomment to also run the API tests that talk to a real renderer (the dev one, running)
# UNNOODLE_TEST_RENDERER_URL=http://127.0.0.1:8189

# pnpm serve: the port of the production web build, which tailscale serve forwards to
UNNOODLE_WEB_PORT=18300

# pnpm serve also starts the dev renderer when this points at its main.py. The Python that runs it is the one on PATH
# unless set; a portable renderer brings its own (python_embeded/python.exe).
# UNNOODLE_DEV_RENDERER_MAIN=
# UNNOODLE_DEV_RENDERER_PYTHON=
