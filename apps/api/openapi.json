{
  "openapi": "3.1.0",
  "info": {
    "title": "unnoodle API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/workflows": {
      "get": {
        "summary": "List Workflows",
        "operationId": "list_workflows_workflows_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkflowOut"
                  },
                  "type": "array",
                  "title": "Response List Workflows Workflows Get"
                }
              }
            }
          }
        }
      }
    },
    "/assets": {
      "post": {
        "summary": "Upload Asset",
        "description": "Stores an uploaded photo or video clip, to attach to generations. Clips are cut to their first 15 seconds.",
        "operationId": "upload_asset_assets_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_asset_assets_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetOut"
                }
              }
            }
          },
          "422": {
            "description": "A clip too short"
          }
        }
      },
      "get": {
        "summary": "List Uploads",
        "description": "Uploads, newest first: the library the composer attaches from.",
        "operationId": "list_uploads_assets_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 60,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetOut"
                  },
                  "title": "Response List Uploads Assets Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/generations": {
      "post": {
        "summary": "Create Generation",
        "description": "Queues count generations, oldest first in the answer.",
        "operationId": "create_generation_generations_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenerationOut"
                  },
                  "title": "Response Create Generation Generations Post"
                }
              }
            }
          },
          "422": {
            "description": "Can't be run"
          }
        }
      },
      "get": {
        "summary": "List Generations",
        "description": "Newest first: all of them (My generations), or one project's. For the next page, pass the id of the last one\nreceived as before.",
        "operationId": "list_generations_generations_get",
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "title": "Limit"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenerationOut"
                  },
                  "title": "Response List Generations Generations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/generations/{generation_id}": {
      "get": {
        "summary": "Get Generation",
        "operationId": "get_generation_generations__generation_id__get",
        "parameters": [
          {
            "name": "generation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Generation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationOut"
                }
              }
            }
          },
          "404": {
            "description": "No such generation"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "summary": "List Projects",
        "description": "Newest first.",
        "operationId": "list_projects_projects_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectOut"
                  },
                  "type": "array",
                  "title": "Response List Projects Projects Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Project",
        "operationId": "create_project_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "summary": "Get Project",
        "operationId": "get_project_projects__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectOut"
                }
              }
            }
          },
          "404": {
            "description": "No such project"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/preferences": {
      "get": {
        "summary": "Get Preferences",
        "operationId": "get_preferences_preferences_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesOut"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Preferences",
        "operationId": "update_preferences_preferences_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptsOut": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/InputRole"
          },
          "media_type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "most": {
            "type": "integer",
            "title": "Most"
          }
        },
        "type": "object",
        "required": [
          "role",
          "media_type",
          "most"
        ],
        "title": "AcceptsOut"
      },
      "AssetOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "media_type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "source": {
            "$ref": "#/components/schemas/AssetSource"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "thumbnail_url": {
            "type": "string",
            "title": "Thumbnail Url"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "media_type",
          "source",
          "url",
          "thumbnail_url",
          "width",
          "height",
          "duration_s",
          "created_at"
        ],
        "title": "AssetOut"
      },
      "AssetSource": {
        "type": "string",
        "enum": [
          "upload",
          "generation"
        ],
        "title": "AssetSource"
      },
      "Body_upload_asset_assets_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_asset_assets_post"
      },
      "Capability": {
        "type": "string",
        "enum": [
          "image.generate",
          "image.edit",
          "video.generate",
          "video.reference"
        ],
        "title": "Capability"
      },
      "GenerationIn": {
        "properties": {
          "media_type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputIn"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Inputs",
            "default": []
          },
          "params": {
            "$ref": "#/components/schemas/Params"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          }
        },
        "type": "object",
        "required": [
          "media_type",
          "prompt",
          "params"
        ],
        "title": "GenerationIn",
        "description": "What the composer sends. It names no workflow: the inputs' roles decide one."
      },
      "GenerationInputOut": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/InputRole"
          },
          "asset": {
            "$ref": "#/components/schemas/AssetOut"
          }
        },
        "type": "object",
        "required": [
          "role",
          "asset"
        ],
        "title": "GenerationInputOut"
      },
      "GenerationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/GenerationStatus"
          },
          "capability": {
            "$ref": "#/components/schemas/Capability"
          },
          "workflow_id": {
            "type": "string",
            "title": "Workflow Id"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "params": {
            "$ref": "#/components/schemas/ParamsOut"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/GenerationInputOut"
            },
            "type": "array",
            "title": "Inputs"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/AssetOut"
            },
            "type": "array",
            "title": "Outputs"
          },
          "progress": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "capability",
          "workflow_id",
          "prompt",
          "project_id",
          "params",
          "inputs",
          "outputs",
          "progress",
          "error",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "GenerationOut"
      },
      "GenerationStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "failed",
          "done"
        ],
        "title": "GenerationStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "title": "Db"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db"
        ],
        "title": "Health"
      },
      "InputIn": {
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Asset Id"
          },
          "role": {
            "$ref": "#/components/schemas/InputRole"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "role"
        ],
        "title": "InputIn"
      },
      "InputRole": {
        "type": "string",
        "enum": [
          "reference"
        ],
        "title": "InputRole",
        "description": "What an attached asset is for. The output type plus the roles of the inputs decide the capability.\n\nThere is one role while every workflow treats its inputs alike; start and end frames would be others."
      },
      "MediaType": {
        "type": "string",
        "enum": [
          "image",
          "video"
        ],
        "title": "MediaType"
      },
      "Params": {
        "properties": {
          "quality": {
            "$ref": "#/components/schemas/Quality",
            "default": "medium"
          },
          "aspect_ratio": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "9:16",
                  "16:9",
                  "21:9"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspect Ratio"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Count",
            "default": 1
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9007199254740991.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "title": "Params"
      },
      "ParamsOut": {
        "properties": {
          "quality": {
            "$ref": "#/components/schemas/Quality",
            "default": "medium"
          },
          "aspect_ratio": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "9:16",
                  "16:9",
                  "21:9"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspect Ratio"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "seed"
        ],
        "title": "ParamsOut"
      },
      "PreferencesIn": {
        "properties": {
          "smart_queue": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Smart Queue"
          }
        },
        "type": "object",
        "title": "PreferencesIn"
      },
      "PreferencesOut": {
        "properties": {
          "smart_queue": {
            "type": "boolean",
            "title": "Smart Queue"
          }
        },
        "type": "object",
        "required": [
          "smart_queue"
        ],
        "title": "PreferencesOut"
      },
      "ProjectIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectIn"
      },
      "ProjectOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "generation_count": {
            "type": "integer",
            "title": "Generation Count"
          },
          "covers": {
            "items": {
              "$ref": "#/components/schemas/AssetOut"
            },
            "type": "array",
            "title": "Covers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "generation_count",
          "covers"
        ],
        "title": "ProjectOut"
      },
      "Quality": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Quality",
        "description": "How big an output is: each workflow maps these to its own sizes and the person never sees pixels."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkflowOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
