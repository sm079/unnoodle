# Copy to deploy/.env on the server. Keep the real file there only; it is never committed.

# Any long random string, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# The API's public name, which Caddy gets a certificate for. With no domain, sslip.io turns the server's IP into one:
# a server at 203.0.113.7 is api-203-0-113-7.sslip.io
API_HOST=

UNNOODLE_PIPELINES=real

# Rent a GPU on RunPod while generations wait, and hand it back after 5 idle minutes, at most 2 hours a day
# (UNNOODLE_GPU_IDLE_STOP_S, UNNOODLE_GPU_DAILY_LIMIT_S). The gpu service tunnels its renderer to gpu:8288.
# Set the RunPod account's spend limit too: it's the last line if everything else fails.
UNNOODLE_GPU=runpod
UNNOODLE_RUNPOD_API_KEY=
# A Hugging Face read token whose account accepted the FLUX.2 [klein] licence (the weights are gated)
UNNOODLE_HF_TOKEN=

# Or run a renderer yourself, with UNNOODLE_GPU=off and this pointing at it
# UNNOODLE_RENDERER_URL=http://host.docker.internal:8188

# Pin an image built from a given commit instead of the newest one
# API_IMAGE=ghcr.io/sm079/unnoodle-api:sha-<commit>
